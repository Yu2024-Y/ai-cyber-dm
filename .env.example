# ⚠️ 复制本文件为 .env 并填入真实值。严禁将真实 .env 提交到 git！

# SiliconFlow（硅基流动）API 配置
# 获取方式：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# LLM 模型（DM 剧情生成）
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 生图模型（场景卡/角色卡）
IMAGE_MODEL=Qwen/Qwen-Image

# 视觉多模态模型
VISION_MODEL=Qwen/Qwen3.6-35B-A3B

# 生图限流参数（SiliconFlow 免费额度速率）
IMAGE_RATE_LIMIT_PER_MINUTE=2

# TTS 配置（edge-tts 本地合成，无需 Key）
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 数据库
DATABASE_URL=sqlite:///./campaign.db

# 服务端口
APP_PORT=8000
