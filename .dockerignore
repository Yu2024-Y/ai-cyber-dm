# Docker 构建上下文排除清单。
# 注意：.gitignore 不作用于构建上下文，本地残留（.venv/campaign.db/.env）必须在此显式排除。

# ── 版本控制 / CI ────────────────────────
.git/
.github/
.gitignore

# ── 虚拟环境与缓存（.venv 约 144MB）──────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ── 测试 / 评测 / 文档 / 脚本（运行期不需要）──
tests/
features/
eval/
docs/
scripts/
AGENTS.md
README.md
LICENSE

# ── 密钥：绝不进镜像（AGENTS.md 安全红线）──
.env
.env.local
.env.*.local

# ── 运行期产物 / 本地数据 ────────────────
*.db
*.sqlite3
*.log
pdf_content.txt
demo_tts.mp3
static/generated/*
!static/generated/.gitkeep

# ── 系统 / 编辑器 ───────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
